From 353bf3e6a626bbc55f23373c86a10c64d3bb9f2d Mon Sep 17 00:00:00 2001
From: Uladzislau Rezki <urezki@gmail.com>
Date: Sun, 1 Nov 2026 00:26:43 +0800
Subject: [PATCH 11/12] BACKPORT: workqueue: Make queue_rcu_work() use
 call_rcu_hurry()

queue_rcu_work() callers are not necessarily OK with long delays, and dst_release() is on the network fast path. Use call_rcu_hurry() for both.

Backported from ACK android14-5.15 commit a7e30c0e9a5f and upstream dst_release change.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 kernel/workqueue.c | 2 +-
 net/core/dst.c     | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/kernel/workqueue.c b/kernel/workqueue.c
index 03bd6b017..dbc6b464a 100644
--- a/kernel/workqueue.c
+++ b/kernel/workqueue.c
@@ -1777,7 +1777,7 @@ bool queue_rcu_work(struct workqueue_struct *wq, struct rcu_work *rwork)
 
 	if (!test_and_set_bit(WORK_STRUCT_PENDING_BIT, work_data_bits(work))) {
 		rwork->wq = wq;
-		call_rcu(&rwork->rcu, rcu_work_rcufn);
+		call_rcu_hurry(&rwork->rcu, rcu_work_rcufn);
 		return true;
 	}
 
diff --git a/net/core/dst.c b/net/core/dst.c
index e508ca488..5319a5ee1 100644
--- a/net/core/dst.c
+++ b/net/core/dst.c
@@ -178,7 +178,7 @@ void dst_release(struct dst_entry *dst)
 					     __func__, dst, newrefcnt);
 		if (!newrefcnt){
 			dst_count_dec(dst);
-			call_rcu(&dst->rcu_head, dst_destroy_rcu);
+			call_rcu_hurry(&dst->rcu_head, dst_destroy_rcu);
 		}
 	}
 }
