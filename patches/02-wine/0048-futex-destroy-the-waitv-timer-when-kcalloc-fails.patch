From 8590ea2ff18c88d33a1abef22aa23fc3adc94fb9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 15:52:26 +0000
Subject: [PATCH] futex: destroy the waitv timer when kcalloc() fails

Same fix as upstream commit 94cd8fa09f5f ("futex: Fix futex_waitv()
hrtimer debug object leak on kcalloc error"): the backport returned
-ENOMEM after futex_setup_timer() without destroy_hrtimer_on_stack(),
which leaks a debug object with CONFIG_DEBUG_OBJECTS_TIMERS=y.
---
 kernel/futex/core.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/kernel/futex/core.c b/kernel/futex/core.c
index 413ed21a0..db7708599 100644
--- a/kernel/futex/core.c
+++ b/kernel/futex/core.c
@@ -4334,19 +4334,22 @@ static long __futex_waitv(struct futex_waitv __user *waiters,
 	}
 
 	futexv = kcalloc(nr_futexes, sizeof(*futexv), GFP_KERNEL);
-	if (!futexv)
-		return -ENOMEM;
+	if (!futexv) {
+		ret = -ENOMEM;
+		goto destroy_timer;
+	}
 
 	ret = futex_parse_waitv(futexv, waiters, nr_futexes);
 	if (!ret)
 		ret = futex_wait_multiple(futexv, nr_futexes, timeout ? &to : NULL);
 
+	kfree(futexv);
+
+destroy_timer:
 	if (timeout) {
 		hrtimer_cancel(&to.timer);
 		destroy_hrtimer_on_stack(&to.timer);
 	}
-
-	kfree(futexv);
 	return ret;
 }
 
