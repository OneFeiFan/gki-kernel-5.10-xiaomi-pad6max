From 848c3d211f14e94d0187635415f73d3a45d0a452 Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Sat, 31 Oct 2026 20:10:13 +0800
Subject: [PATCH] mm: le9uo: add an OOM escape when all scan targets are zero

The le9uo hard watermarks can zero every evictable LRU target in get_scan_count(). Without a fallback the scan makes no progress, priority drops, and the node can only exit through OOM. Refill targets only when all of them are zero, preserving the normal SCAN_ANON/SCAN_FILE steering.

Origin: Steambot12 Templar b21d737185 / 17ea8a084b. In this tree prepare_workingset_protection() already runs before shrink_node_memcgs(); only the escape is added.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 mm/vmscan.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/mm/vmscan.c b/mm/vmscan.c
index 8b80e67e6..84aa65a3d 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -2687,6 +2687,34 @@ static void shrink_lruvec(struct lruvec *lruvec, struct scan_control *sc)
 
 	get_scan_count(lruvec, sc, nr);
 
+	/*
+	 * le9uo's hard watermarks can zero every scan target when all
+	 * evictable LRUs are below their floors. Without a fallback the
+	 * scan makes no progress, priority drops, and the node can only
+	 * exit through OOM. Refill only when every target is zero so the
+	 * normal SCAN_ANON/SCAN_FILE steering is preserved.
+	 */
+	{
+		bool all_zero = true;
+
+		for_each_evictable_lru(lru) {
+			if (nr[lru]) {
+				all_zero = false;
+				break;
+			}
+		}
+		if (all_zero) {
+			for_each_evictable_lru(lru) {
+				unsigned long size;
+
+				size = lruvec_lru_size(lruvec, lru,
+						       sc->reclaim_idx);
+				if (size)
+					nr[lru] = size / (1UL << sc->priority);
+			}
+		}
+	}
+
 	/* Record the original scan target for proportional adjustments later */
 	memcpy(targets, nr, sizeof(nr));
 
