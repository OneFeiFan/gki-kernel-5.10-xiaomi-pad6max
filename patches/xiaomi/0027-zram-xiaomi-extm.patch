+
+	time_list = kmalloc_array(time_nr,
+				sizeof(*time_list), GFP_KERNEL);
+	if (!time_list) {
+		ret = -ENOMEM;
+		goto free_arg_buf;
+	}
+	for (i = 0; i < time_nr; i++) {
