+static void free_pages_life(struct zram_pages_life *pl)
+{
+	if (!pl || !pl->time_nr)
+		return;
+
+	pl->time_nr = 0;
+	if (pl->time_list) {
+		kfree(pl->time_list);
+		pl->time_list = NULL;
+	}
+	if (pl->time_list) {
+		kfree(pl->lifes);
+		pl->lifes = NULL;
+	}
+	if (pl) {
+		kfree(pl);
+		pl = NULL;
+	}
+}
