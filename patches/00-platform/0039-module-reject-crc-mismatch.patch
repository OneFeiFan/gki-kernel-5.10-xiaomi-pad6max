From 9d5a1db2a05bc175e18a9f59f410bc7a91303bb4 Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Wed, 28 Oct 2026 22:41:27 +0800
Subject: [PATCH] module: reject CRC mismatches again

A local patch made bad_version return success, so modules with
mismatched symbol CRCs loaded silently. Restore the stock warning and
rejection path; keep the project's zram symbol blacklist.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 kernel/module.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/kernel/module.c b/kernel/module.c
index 87d119278..7ae8e3c63 100644
--- a/kernel/module.c
+++ b/kernel/module.c
@@ -1346,8 +1346,9 @@ static int check_version(const struct load_info *info,
 	return 1;
 
 bad_version:
-
-	return 1;
+	pr_warn("%s: disagrees about version of symbol %s\n",
+	       info->name, symname);
+	return 0;
 }
 
 static inline int check_modstruct_version(const struct load_info *info,
