From 9d8a03430ff299c7d206e5e8df39f0d7a61c7d09 Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Thu, 29 Oct 2026 01:52:57 +0800
Subject: [PATCH] kmi: restore module CRC rejection and pin the IPC/netns
 layouts

Restore the 5.10 module CRC rejection path, move ipc_ids.next_id into a side table (key_ht stays at 104 and the struct stays 272), pin netns_ipv4.tcp_death_row at 640, and keep the project's zram symbol blacklist.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 include/linux/ipc_namespace.h |  16 ++++-
 include/net/netns/ipv4.h      |  31 ++++++---
 ipc/ipc_sysctl.c              |  54 +++++++++++++---
 ipc/namespace.c               |   2 +
 ipc/util.c                    | 117 +++++++++++++++++++++++++++++++---
 ipc/util.h                    |  18 ++++++
 kernel/module.c               |  23 ++++++-
 7 files changed, 229 insertions(+), 32 deletions(-)

diff --git a/include/linux/ipc_namespace.h b/include/linux/ipc_namespace.h
index 083251051..73d630dca 100644
--- a/include/linux/ipc_namespace.h
+++ b/include/linux/ipc_namespace.h
@@ -10,6 +10,8 @@
 #include <linux/ns_common.h>
 #include <linux/refcount.h>
 #include <linux/rhashtable-types.h>
+#include <linux/build_bug.h>
+#include <linux/stddef.h>
 
 struct user_namespace;
 
@@ -20,12 +22,20 @@ struct ipc_ids {
 	struct idr ipcs_idr;
 	int max_idx;
 	int last_idx;	/* For wrap around detection */
-#ifdef CONFIG_CHECKPOINT_RESTORE
-	int next_id;
-#endif
 	struct rhashtable key_ht;
 };
 
+/*
+ * KMI pins for the AOSP GKI layout (reference kernel has
+ * CONFIG_CHECKPOINT_RESTORE disabled). The checkpoint/restore next_id
+ * field is kept out of line in ipc/util.c so enabling that option does
+ * not move key_ht or grow the struct.
+ */
+#ifndef __GENKSYMS__
+static_assert(offsetof(struct ipc_ids, key_ht) == 104);
+static_assert(sizeof(struct ipc_ids) == 272);
+#endif
+
 struct ipc_namespace {
 	refcount_t	count;
 	struct ipc_ids	ids[3];
