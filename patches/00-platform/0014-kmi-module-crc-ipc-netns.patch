 {
-	int idx, next_id = -1;
+	int idx, next_id;
 
-#ifdef CONFIG_CHECKPOINT_RESTORE
-	next_id = ids->next_id;
-	ids->next_id = -1;
-#endif
+	next_id = ipc_next_id_take(ids);
 
 	/*
 	 * As soon as a new object is inserted into the idr,
diff --git a/ipc/util.h b/ipc/util.h
index 5766c61ae..72316a95f 100644
--- a/ipc/util.h
+++ b/ipc/util.h
@@ -113,6 +113,24 @@ struct seq_file;
 struct ipc_ids;
 
