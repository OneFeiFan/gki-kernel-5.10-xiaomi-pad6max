 include/linux/ipc_namespace.h    |  16 ++++-
 ipc/ipc_sysctl.c                 |  54 +++++++++++---
 ipc/namespace.c                  |   2 +
 ipc/util.c                       | 117 ++++++++++++++++++++++++++++---
 ipc/util.h                       |  18 +++++
 6 files changed, 192 insertions(+), 21 deletions(-)

