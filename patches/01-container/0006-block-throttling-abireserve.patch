From c175e9a7755df237fa31340fbed53b1646409787 Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Thu, 29 Oct 2026 01:52:55 +0800
Subject: [PATCH] block: overlay block throttling state on the KABI reserve
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

CONFIG_BLK_DEV_THROTTLING needs a throtl_data pointer in struct request_queue. Overlay it on ANDROID_KABI_RESERVE(1) and hide it from genksyms so request_queue keeps its stock CRC.

Enable BLK_DEV_THROTTLING in gki_defconfig.

Co-Authored-By: Claude Code <noreply@anthropic.com>

Origin: 本地实现（2026-10-29 检索 refs 全部仓库、GitHub 代码搜索与网页，未找到外部来源；功能清单参考 kernel-workshop-docker 的 defconfig，KABI 方案为自行设计）
Upstream-Status: Not-Applicable
KABI: request_queue ANDROID_KABI_RESERVE(1)；__GENKSYMS__ 守卫
Depends-On: none
Tested-On: yudi 5.10.272, 2026-10-29
---
 arch/arm64/configs/gki_defconfig |  2 ++
 include/linux/blkdev.h           | 19 +++++++++++++++----
 2 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 27c19afd9..0cf694046 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -451,6 +451,8 @@ CONFIG_SCSI_UFS_CRYPTO=y
 CONFIG_SCSI_UFS_HPB=y
 CONFIG_MD=y
 CONFIG_BLK_DEV_DM=y
+# yudi: blkio throttling (state on the request_queue KABI reserve)
+CONFIG_BLK_DEV_THROTTLING=y
 CONFIG_DM_CRYPT=y
 CONFIG_DM_DEFAULT_KEY=y
 CONFIG_DM_SNAPSHOT=y
diff --git a/include/linux/blkdev.h b/include/linux/blkdev.h
index 961bfbf54..198142db9 100644
--- a/include/linux/blkdev.h
+++ b/include/linux/blkdev.h
@@ -573,10 +573,6 @@ struct request_queue {
 	struct bsg_class_device bsg_dev;
 #endif
 
-#ifdef CONFIG_BLK_DEV_THROTTLING
-	/* Throttle data */
-	struct throtl_data *td;
-#endif
 	struct rcu_head		rcu_head;
 	wait_queue_head_t	mq_freeze_wq;
 	/*
@@ -603,7 +599,22 @@ struct request_queue {
 #define BLK_MAX_WRITE_HINTS	5
 	u64			write_hints[BLK_MAX_WRITE_HINTS];
 
+	/*
+	 * Throttle data overlays KABI reserve 1; hidden from genksyms so
+	 * request_queue's KMI CRC stays at the stock value.
+	 */
+#if defined(CONFIG_BLK_DEV_THROTTLING) && !defined(__GENKSYMS__)
+	union {
+		struct {
+			ANDROID_KABI_RESERVE(1);
+		};
+		struct {
+			struct throtl_data *td;
+		};
+	};
+#else
 	ANDROID_KABI_RESERVE(1);
+#endif
 	ANDROID_KABI_RESERVE(2);
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
-- 
2.43.0

