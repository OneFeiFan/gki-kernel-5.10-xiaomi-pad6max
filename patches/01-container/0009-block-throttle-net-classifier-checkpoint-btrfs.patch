From 764e61cf9c690536a8ed4d914b6991cb4b3db25e Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Sun, 25 Oct 2026 21:06:56 +0800
Subject: [PATCH] phase7: block throttle, net classifier, checkpoint/restore,
 Btrfs

- Enable BLK_DEV_THROTTLING, NET_CLS_CGROUP, CHECKPOINT_RESTORE,
  BTRFS_FS and BTRFS_FS_POSIX_ACL.
- request_queue: throtl_data overlays KABI reserve 1; hidden from
  genksyms so the stock KMI CRC is preserved (size 2096, td at 2056).
- ipc_ids: next_id hidden from genksyms (CHECKPOINT_RESTORE only).
- kernel/sched/sched.h: CFS bandwidth fields hidden from genksyms too;
  CONFIG_CFS_BANDWIDTH itself stays off because it prevents this device
  from reaching adbd (bisect: CFS+BLK fails, BLK alone boots, and
  everything except CFS boots).
- Gates: 7298-symbol symvers diff 0, 355 vendor modules pass,
  request_queue 2096, struct net 4672.
- Device: adbd up, 425 modules, KSU root, btrfs in /proc/filesystems,
  blk_throtl and seccomp_get_filter symbols present.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 arch/arm64/configs/gki_defconfig |  9 +++++++++
 include/linux/blkdev.h           | 19 +++++++++++++++----
 include/linux/ipc_namespace.h    |  2 +-
 kernel/sched/sched.h             |  4 ++--
 4 files changed, 27 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 30d35cc1f..e6b307570 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -852,3 +852,12 @@ CONFIG_NET_SCH_PLUG=y
 CONFIG_NET_SCH_ETS=y
 CONFIG_NET_SCH_DEFAULT=y
 CONFIG_NET_SCH_FQ_PIE=y
+
+# Phase 7: block throttle, net classifier, checkpoint, Btrfs.
+# CFS_BANDWIDTH is deferred: enabling it prevents this vendor kernel from
+# reaching adbd (boot bisect 2026-10-25: CFS+BLK fails, BLK alone boots).
+CONFIG_BLK_DEV_THROTTLING=y
+CONFIG_NET_CLS_CGROUP=y
+CONFIG_CHECKPOINT_RESTORE=y
+CONFIG_BTRFS_FS=y
+CONFIG_BTRFS_FS_POSIX_ACL=y
diff --git a/include/linux/blkdev.h b/include/linux/blkdev.h
index 961bfbf54..198142db9 100644
--- a/include/linux/blkdev.h
+++ b/include/linux/blkdev.h
@@ -573,10 +573,6 @@ struct request_queue {
 	struct bsg_class_device bsg_dev;
 #endif
 
-#ifdef CONFIG_BLK_DEV_THROTTLING
-	/* Throttle data */
-	struct throtl_data *td;
-#endif
 	struct rcu_head		rcu_head;
 	wait_queue_head_t	mq_freeze_wq;
 	/*
@@ -603,7 +599,22 @@ struct request_queue {
 #define BLK_MAX_WRITE_HINTS	5
 	u64			write_hints[BLK_MAX_WRITE_HINTS];
 
+	/*
+	 * Throttle data overlays KABI reserve 1; hidden from genksyms so
+	 * request_queue's KMI CRC stays at the stock value.
+	 */
+#if defined(CONFIG_BLK_DEV_THROTTLING) && !defined(__GENKSYMS__)
+	union {
+		struct {
+			ANDROID_KABI_RESERVE(1);
+		};
+		struct {
+			struct throtl_data *td;
+		};
+	};
+#else
 	ANDROID_KABI_RESERVE(1);
+#endif
 	ANDROID_KABI_RESERVE(2);
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
diff --git a/include/linux/ipc_namespace.h b/include/linux/ipc_namespace.h
index 083251051..ed9f5d4a2 100644
--- a/include/linux/ipc_namespace.h
+++ b/include/linux/ipc_namespace.h
@@ -20,7 +20,7 @@ struct ipc_ids {
 	struct idr ipcs_idr;
 	int max_idx;
 	int last_idx;	/* For wrap around detection */
-#ifdef CONFIG_CHECKPOINT_RESTORE
+#if defined(CONFIG_CHECKPOINT_RESTORE) && !defined(__GENKSYMS__)
 	int next_id;
 #endif
 	struct rhashtable key_ht;
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index 88696e04a..f292d8a39 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -363,7 +363,7 @@ struct rt_rq;
 extern struct list_head task_groups;
 
 struct cfs_bandwidth {
-#ifdef CONFIG_CFS_BANDWIDTH
+#if defined(CONFIG_CFS_BANDWIDTH) && !defined(__GENKSYMS__)
 	raw_spinlock_t		lock;
 	ktime_t			period;
 	u64			quota;
@@ -603,7 +603,7 @@ struct cfs_rq {
 	struct list_head	leaf_cfs_rq_list;
 	struct task_group	*tg;	/* group that "owns" this runqueue */
 
-#ifdef CONFIG_CFS_BANDWIDTH
+#if defined(CONFIG_CFS_BANDWIDTH) && !defined(__GENKSYMS__)
 	int			runtime_enabled;
 	s64			runtime_remaining;
 
