From 39fd319eb023295eb86df76350f952b601cd398e Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Sun, 25 Oct 2026 17:39:50 +0800
Subject: [PATCH] GKI: enable CGROUP_PERF with an ABI-safe cgrp split

CONFIG_CGROUP_PERF adds struct perf_cgroup *cgrp to struct perf_event and
int nr_cgroups to struct perf_event_context.  struct perf_event_context
is reachable from task_struct, so enabling the controller changes the
genksyms CRCs of about 1000 exported symbols and makes every vendor
module fail to load (module_layout included).

Keep both the runtime layout and the CRCs identical to a kernel built
without CGROUP_PERF:

- struct perf_event: replace the cgrp pointer with cgrp_high/cgrp_low,
  placed in the two 4-byte holes of the stock layout (offsets 732 and
  772), accessed through get_cgrp()/set_cgrp()
- struct perf_event_context: nr_cgroups fills the natural 4-byte hole
  after pin_count (offset 244)
- struct perf_cpu_context: keep the fields as-is (internal type)
- hide all added/changed fields from genksyms so it still sees the stock
  declarations
- kernel/events/core.c: route the 30 reads and 2 writes through the
  accessors; BUILD_BUG_ON the offsets and struct sizes

Validated on device: 7298/7298 symbol CRCs identical to the baseline,
355/355 vendor modules match, kernel boots, /proc/cgroups shows
perf_event, KernelSU root works.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 arch/arm64/configs/gki_defconfig |  6 ++--
 include/linux/cgroup-defs.h      |  6 ++--
 include/linux/cgroup_subsys.h    |  6 ++--
 include/linux/perf_event.h       | 44 ++++++++++++++++++++++----
 kernel/events/core.c             | 53 ++++++++++++++++++--------------
 5 files changed, 76 insertions(+), 39 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 8fc4cbe85..7d759b1f4 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -713,8 +713,6 @@ CONFIG_IP_SET_HASH_NET=y
 CONFIG_NETFILTER_XT_SET=y
 CONFIG_CGROUP_DEVICE=y
 CONFIG_CGROUP_PIDS=y
-# CONFIG_CGROUP_PERF is not set
-# CGROUP_PERF adds fields to struct perf_event (reachable from task_struct),
-# which changes the CRCs of ~1000 exported symbols and breaks vendor modules.
-# Docker's check-config.sh lists CGROUP_PERF as optional only.
+# CGROUP_PERF keeps the stock KMI via the cgrp split in linux/perf_event.h.
+CONFIG_CGROUP_PERF=y
 CONFIG_CGROUP_NET_CLASSID=y
diff --git a/include/linux/cgroup-defs.h b/include/linux/cgroup-defs.h
index 18d504ad6..11cbe0950 100644
--- a/include/linux/cgroup-defs.h
+++ b/include/linux/cgroup-defs.h
@@ -54,10 +54,10 @@ enum cgroup_subsys_id {
  * the extra controllers are stored in separately allocated ext structures.
  * CGROUP_SUBSYS_MAIN_COUNT must equal the stock (7) controller count, so
  * CGROUP_SUBSYS_EXT_SLOTS must match the number of enabled ext controllers
- * (devices, pids, net_cls = 3).  CGROUP_PERF is not enabled: it adds fields
- * to struct perf_event, which changes the KMI CRCs of most exported symbols.
+ * (devices, pids, perf_event, net_cls = 4).  CGROUP_PERF keeps the stock
+ * KMI by storing cgrp in stock layout holes in linux/perf_event.h.
  */
-#define CGROUP_SUBSYS_EXT_SLOTS		3
+#define CGROUP_SUBSYS_EXT_SLOTS		4
 /*
  * genksyms folds array bounds and the enum cgroup_subsys_id members into the
  * symbol CRCs.  To keep those identical to the stock 5.10 kernel, genksyms
diff --git a/include/linux/cgroup_subsys.h b/include/linux/cgroup_subsys.h
index 21fd4efed..07191d6a3 100644
--- a/include/linux/cgroup_subsys.h
+++ b/include/linux/cgroup_subsys.h
@@ -71,9 +71,9 @@ SUBSYS(pids)
 #endif
 
 /*
- * perf_event stays disabled: CONFIG_CGROUP_PERF adds fields to struct
- * perf_event (reachable from task_struct) and changes ~1000 KMI CRCs.
- * If it is ever enabled, CGROUP_SUBSYS_EXT_SLOTS must be bumped too.
+ * perf_event keeps the stock KMI: its cgrp pointer is split across two u32
+ * fields placed in stock layout holes in include/linux/perf_event.h, and
+ * those fields are hidden from genksyms.
  */
 #if IS_ENABLED(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
 SUBSYS(perf_event)
diff --git a/include/linux/perf_event.h b/include/linux/perf_event.h
index 5cac2f291..d8c8d9049 100644
--- a/include/linux/perf_event.h
+++ b/include/linux/perf_event.h
@@ -725,11 +725,22 @@ struct perf_event {
 	/* mmap bits */
 	struct mutex			mmap_mutex;
 	atomic_t			mmap_count;
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+	/*
+	 * The stock layout has a 4-byte hole here.  Store the high half of
+	 * the cgroup pointer in it so the layout stays ABI-compatible; the
+	 * low half lives in the hole after rcu_pending.  See get_cgrp().
+	 */
+	u32				cgrp_high;
+#endif
 
 	struct perf_buffer		*rb;
 	struct list_head		rb_entry;
 	unsigned long			rcu_batches;
 	int				rcu_pending;
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+	u32				cgrp_low;
+#endif
 
 	/* poll related */
 	wait_queue_head_t		waitq;
@@ -774,10 +785,6 @@ struct perf_event {
 #endif
 #endif
 
-#ifdef CONFIG_CGROUP_PERF
-	struct perf_cgroup		*cgrp; /* cgroup event is attach to */
-#endif
-
 #ifdef CONFIG_SECURITY
 	void *security;
 #endif
@@ -785,6 +792,29 @@ struct perf_event {
 #endif /* CONFIG_PERF_EVENTS */
 };
 
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+/*
+ * struct perf_event has no free pointer-sized field.  Keep the cgroup
+ * pointer split across the two 4-byte holes of the stock layout (after
+ * mmap_count and rcu_pending) so that both the runtime layout and the
+ * genksyms CRCs stay identical to a kernel built without CGROUP_PERF.
+ */
+static inline struct perf_cgroup *get_cgrp(const struct perf_event *event)
+{
+	u64 val = ((u64)READ_ONCE(event->cgrp_high) << 32) |
+		  READ_ONCE(event->cgrp_low);
+
+	return (struct perf_cgroup *)(unsigned long)val;
+}
+
+static inline void set_cgrp(struct perf_event *event, struct perf_cgroup *cgrp)
+{
+	u64 val = (u64)(unsigned long)cgrp;
+
+	WRITE_ONCE(event->cgrp_high, (u32)(val >> 32));
+	WRITE_ONCE(event->cgrp_low, (u32)val);
+}
+#endif
 
 struct perf_event_groups {
 	struct rb_root	tree;
@@ -846,7 +876,8 @@ struct perf_event_context {
 	u64				parent_gen;
 	u64				generation;
 	int				pin_count;
-#ifdef CONFIG_CGROUP_PERF
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+	/* Fills the 4-byte hole before task_ctx_data: layout stays stock. */
 	int				nr_cgroups;	 /* cgroup evts */
 #endif
 	void				*task_ctx_data; /* pmu specific data */
@@ -873,7 +904,8 @@ struct perf_cpu_context {
 	ktime_t				hrtimer_interval;
 	unsigned int			hrtimer_active;
 
-#ifdef CONFIG_CGROUP_PERF
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+	/* Internal type: no exported symbol uses struct perf_cpu_context. */
 	struct perf_cgroup		*cgrp;
 	struct list_head		cgrp_cpuctx_entry;
 #endif
diff --git a/kernel/events/core.c b/kernel/events/core.c
index 5e8cd2c6a..9cffe65d2 100644
--- a/kernel/events/core.c
+++ b/kernel/events/core.c
@@ -681,8 +681,15 @@ perf_cgroup_match(struct perf_event *event)
 	struct perf_event_context *ctx = event->ctx;
 	struct perf_cpu_context *cpuctx = __get_cpu_context(ctx);
 
+	/* Keep the stock struct perf_event / perf_event_context layout. */
+	BUILD_BUG_ON(offsetof(struct perf_event, cgrp_high) != 732);
+	BUILD_BUG_ON(offsetof(struct perf_event, cgrp_low) != 772);
+	BUILD_BUG_ON(offsetof(struct perf_event_context, nr_cgroups) != 244);
+	BUILD_BUG_ON(sizeof(struct perf_event) != 1024);
+	BUILD_BUG_ON(sizeof(struct perf_event_context) != 272);
+
 	/* @event doesn't care about cgroup */
-	if (!event->cgrp)
+	if (!get_cgrp(event))
 		return true;
 
 	/* wants specific cgroup scope but @cpuctx isn't associated with any */
@@ -696,25 +703,25 @@ perf_cgroup_match(struct perf_event *event)
 	 * case), it's a match.
 	 */
 	return cgroup_is_descendant(cpuctx->cgrp->css.cgroup,
-				    event->cgrp->css.cgroup);
+				    get_cgrp(event)->css.cgroup);
 }
 
 static inline void perf_detach_cgroup(struct perf_event *event)
 {
-	css_put(&event->cgrp->css);
-	event->cgrp = NULL;
+	css_put(&get_cgrp(event)->css);
+	set_cgrp(event, NULL);
 }
 
 static inline int is_cgroup_event(struct perf_event *event)
 {
-	return event->cgrp != NULL;
+	return get_cgrp(event) != NULL;
 }
 
 static inline u64 perf_cgroup_event_time(struct perf_event *event)
 {
 	struct perf_cgroup_info *t;
 
-	t = per_cpu_ptr(event->cgrp->info, event->cpu);
+	t = per_cpu_ptr(get_cgrp(event)->info, event->cpu);
 	return t->time;
 }
 
@@ -759,8 +766,8 @@ static inline void update_cgrp_time_from_event(struct perf_event *event)
 	/*
 	 * Do not update time when cgroup is not active
 	 */
-	if (cgroup_is_descendant(cgrp->css.cgroup, event->cgrp->css.cgroup))
-		__update_cgrp_time(event->cgrp);
+	if (cgroup_is_descendant(cgrp->css.cgroup, get_cgrp(event)->css.cgroup))
+		__update_cgrp_time(get_cgrp(event));
 }
 
 static inline void
@@ -964,14 +971,14 @@ static inline int perf_cgroup_connect(int fd, struct perf_event *event,
 		goto out;
 
 	cgrp = container_of(css, struct perf_cgroup, css);
-	event->cgrp = cgrp;
+	set_cgrp(event, cgrp);
 
 	/*
 	 * all events in a group must monitor
 	 * the same cgroup because a task belongs
 	 * to only one perf cgroup at a time
 	 */
-	if (group_leader && group_leader->cgrp != cgrp) {
+	if (group_leader && get_cgrp(group_leader) != cgrp) {
 		perf_detach_cgroup(event);
 		ret = -EINVAL;
 	}
@@ -984,7 +991,7 @@ static inline void
 perf_cgroup_set_shadow_time(struct perf_event *event, u64 now)
 {
 	struct perf_cgroup_info *t;
-	t = per_cpu_ptr(event->cgrp->info, event->cpu);
+	t = per_cpu_ptr(get_cgrp(event)->info, event->cpu);
 	event->shadow_ctx_time = now - t->timestamp;
 }
 
@@ -1011,7 +1018,7 @@ perf_cgroup_event_enable(struct perf_event *event, struct perf_event_context *ct
 	if (ctx->is_active && !cpuctx->cgrp) {
 		struct perf_cgroup *cgrp = perf_cgroup_from_task(current, ctx);
 
-		if (cgroup_is_descendant(cgrp->css.cgroup, event->cgrp->css.cgroup))
+		if (cgroup_is_descendant(cgrp->css.cgroup, get_cgrp(event)->css.cgroup))
 			cpuctx->cgrp = cgrp;
 	}
 
@@ -1614,15 +1621,15 @@ perf_event_groups_less(struct perf_event *left, struct perf_event *right)
 		return false;
 
 #ifdef CONFIG_CGROUP_PERF
-	if (left->cgrp != right->cgrp) {
-		if (!left->cgrp || !left->cgrp->css.cgroup) {
+	if (get_cgrp(left) != get_cgrp(right)) {
+		if (!get_cgrp(left) || !get_cgrp(left)->css.cgroup) {
 			/*
 			 * Left has no cgroup but right does, no cgroups come
 			 * first.
 			 */
 			return true;
 		}
-		if (!right->cgrp || !right->cgrp->css.cgroup) {
+		if (!get_cgrp(right) || !get_cgrp(right)->css.cgroup) {
 			/*
 			 * Right has no cgroup but left does, no cgroups come
 			 * first.
@@ -1630,7 +1637,7 @@ perf_event_groups_less(struct perf_event *left, struct perf_event *right)
 			return false;
 		}
 		/* Two dissimilar cgroups, order by id. */
-		if (left->cgrp->css.cgroup->kn->id < right->cgrp->css.cgroup->kn->id)
+		if (get_cgrp(left)->css.cgroup->kn->id < get_cgrp(right)->css.cgroup->kn->id)
 			return true;
 
 		return false;
@@ -1744,8 +1751,8 @@ perf_event_groups_first(struct perf_event_groups *groups, int cpu,
 		}
 #ifdef CONFIG_CGROUP_PERF
 		node_cgrp_id = 0;
-		if (node_event->cgrp && node_event->cgrp->css.cgroup)
-			node_cgrp_id = node_event->cgrp->css.cgroup->kn->id;
+		if (get_cgrp(node_event) && get_cgrp(node_event)->css.cgroup)
+			node_cgrp_id = get_cgrp(node_event)->css.cgroup->kn->id;
 
 		if (cgrp_id < node_cgrp_id) {
 			node = node->rb_left;
@@ -1780,11 +1787,11 @@ perf_event_groups_next(struct perf_event *event)
 		return NULL;
 
 #ifdef CONFIG_CGROUP_PERF
-	if (event->cgrp && event->cgrp->css.cgroup)
-		curr_cgrp_id = event->cgrp->css.cgroup->kn->id;
+	if (get_cgrp(event) && get_cgrp(event)->css.cgroup)
+		curr_cgrp_id = get_cgrp(event)->css.cgroup->kn->id;
 
-	if (next->cgrp && next->cgrp->css.cgroup)
-		next_cgrp_id = next->cgrp->css.cgroup->kn->id;
+	if (get_cgrp(next) && get_cgrp(next)->css.cgroup)
+		next_cgrp_id = get_cgrp(next)->css.cgroup->kn->id;
 
 	if (curr_cgrp_id != next_cgrp_id)
 		return NULL;
@@ -2824,7 +2831,7 @@ static int  __perf_install_in_context(void *info)
 		 */
 		struct perf_cgroup *cgrp = perf_cgroup_from_task(current, ctx);
 		reprogram = cgroup_is_descendant(cgrp->css.cgroup,
-					event->cgrp->css.cgroup);
+					get_cgrp(event)->css.cgroup);
 	}
 #endif
 
