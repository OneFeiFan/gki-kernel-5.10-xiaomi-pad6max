@@ -677,7 +677,7 @@ struct cgroup_subsys_state *of_css(struct kernfs_open_file *of)
 	 * be and stay valid until the enclosing operation is complete.
 	 */
 	if (cft->ss)
-		return rcu_dereference_raw(cgrp->subsys[cft->ss->id]);
