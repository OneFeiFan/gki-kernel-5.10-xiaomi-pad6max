From d410b43effe3dfa7cff6a20312a4bc4e94c9fc2d Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Thu, 29 Oct 2026 01:52:55 +0800
Subject: [PATCH] cgroup: enable devices, pids, net_cls and perf with ABI-safe
 state
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Keep struct cgroup and css_set sizes unchanged: put the new controller state in the dynamically allocated ext objects and hide the added fields from genksyms.

Enable CGROUP_DEVICE, CGROUP_PIDS, CGROUP_PERF and CGROUP_NET_CLASSID
in gki_defconfig together with the code that keeps them KMI-safe.

Co-Authored-By: Claude Code <noreply@anthropic.com>

Origin: superturtlee/kernel-workshop-docker patch/fulldocker/superkernel.diff（cgroup MAIN/EXT 拆分，本地适配到 5.10 cgroup v1）
Upstream-Status: Not-Applicable
KABI: __GENKSYMS__ 守卫（cgroup v1 MAIN/EXT 拆分）
Depends-On: none
Tested-On: yudi 5.10.272, 2026-10-29
---
 arch/arm64/configs/gki_defconfig |   5 +
 include/linux/cgroup-defs.h      | 150 +++++++++++++++++++++++++++++-
 include/linux/cgroup.h           |   4 +-
 include/linux/cgroup_subsys.h    |  47 ++++++----
 include/linux/perf_event.h       |  44 +++++++--
 kernel/cgroup/cgroup-v1.c        |  10 ++
 kernel/cgroup/cgroup.c           | 155 +++++++++++++++++++++----------
 kernel/cgroup/debug.c            |   4 +-
 kernel/cgroup/pids.c             |   4 +-
 kernel/events/core.c             |  53 ++++++-----
 10 files changed, 372 insertions(+), 104 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index d9df33fff..5496677b0 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -18,6 +18,11 @@ CONFIG_UCLAMP_BUCKETS_COUNT=20
 CONFIG_CGROUPS=y
 CONFIG_MEMCG=y
 CONFIG_BLK_CGROUP=y
+# yudi: cgroup v1 devices/pids/perf/net_cls (KABI-safe cgroup split)
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_PERF=y
+CONFIG_CGROUP_NET_CLASSID=y
 CONFIG_CGROUP_SCHED=y
 CONFIG_UCLAMP_TASK_GROUP=y
 CONFIG_CGROUP_FREEZER=y
diff --git a/include/linux/cgroup-defs.h b/include/linux/cgroup-defs.h
index 3ee42f154..11cbe0950 100644
--- a/include/linux/cgroup-defs.h
+++ b/include/linux/cgroup-defs.h
@@ -21,6 +21,7 @@
 #include <linux/workqueue.h>
 #include <linux/bpf-cgroup.h>
 #include <linux/psi_types.h>
+#include <linux/stddef.h>
 
 #ifdef CONFIG_CGROUPS
 
@@ -46,6 +47,29 @@ enum cgroup_subsys_id {
 };
 #undef SUBSYS
 
+/*
+ * Allow enabling controllers that were added after the 5.10 KMI without
+ * changing the layout of struct css_set / struct cgroup: the first
+ * CGROUP_SUBSYS_MAIN_COUNT ids keep the original in-struct arrays, while
+ * the extra controllers are stored in separately allocated ext structures.
+ * CGROUP_SUBSYS_MAIN_COUNT must equal the stock (7) controller count, so
+ * CGROUP_SUBSYS_EXT_SLOTS must match the number of enabled ext controllers
+ * (devices, pids, perf_event, net_cls = 4).  CGROUP_PERF keeps the stock
+ * KMI by storing cgrp in stock layout holes in linux/perf_event.h.
+ */
+#define CGROUP_SUBSYS_EXT_SLOTS		4
+/*
+ * genksyms folds array bounds and the enum cgroup_subsys_id members into the
+ * symbol CRCs.  To keep those identical to the stock 5.10 kernel, genksyms
+ * must see the stock enum (the ext controllers are hidden from it in
+ * cgroup_subsys.h) and the stock array bound tokens, hence this split.
+ */
+#ifdef __GENKSYMS__
+#define CGROUP_SUBSYS_MAIN_COUNT	CGROUP_SUBSYS_COUNT
+#else
+#define CGROUP_SUBSYS_MAIN_COUNT	(CGROUP_SUBSYS_COUNT - CGROUP_SUBSYS_EXT_SLOTS)
+#endif
+
 /* bits in struct cgroup_subsys_state flags field */
 enum {
 	CSS_NO_REF	= (1 << 0), /* no reference counting for this css */
@@ -199,7 +223,7 @@ struct css_set {
 	 * immutable after creation apart from the init_css_set during
 	 * subsystem registration (at boot time).
 	 */
-	struct cgroup_subsys_state *subsys[CGROUP_SUBSYS_COUNT];
+	struct cgroup_subsys_state *subsys[CGROUP_SUBSYS_MAIN_COUNT];
 
 	/* reference count */
 	refcount_t refcount;
@@ -239,7 +263,7 @@ struct css_set {
 	 * ->subsys[ssid]->cgroup->e_csets[ssid] and provides a way to
 	 * iterate through all css's attached to a given cgroup.
 	 */
-	struct list_head e_cset_node[CGROUP_SUBSYS_COUNT];
+	struct list_head e_cset_node[CGROUP_SUBSYS_MAIN_COUNT];
 
 	/* all threaded csets whose ->dom_cset points to this cset */
 	struct list_head threaded_csets;
@@ -287,6 +311,14 @@ struct ext_css_set {
 
 	struct list_head mg_src_preload_node;
 	struct list_head mg_dst_preload_node;
+
+	/*
+	 * Extension slots for cgroup subsystems added after the 5.10 KMI.
+	 * struct css_set is the first member, so these arrays can be reached
+	 * from any struct css_set * with a plain cast.
+	 */
+	struct cgroup_subsys_state *ext_subsys[CGROUP_SUBSYS_EXT_SLOTS];
+	struct list_head ext_e_cset_node[CGROUP_SUBSYS_EXT_SLOTS];
 };
 
 struct cgroup_base_stat {
@@ -410,6 +442,11 @@ struct cgroup {
 
 	int nr_threaded_children;	/* # of live threaded child cgroups */
 
+#ifndef __GENKSYMS__
+	/* low 32 bits of the extension slots pointer (ABI-neutral padding) */
+	u32 ext_lo;
+#endif
+
 	struct kernfs_node *kn;		/* cgroup kernfs entry */
 	struct cgroup_file procs_file;	/* handle for "cgroup.procs" */
 	struct cgroup_file events_file;	/* handle for "cgroup.events" */
@@ -427,7 +464,7 @@ struct cgroup {
 	u16 old_subtree_ss_mask;
 
 	/* Private pointers for each registered subsystem */
-	struct cgroup_subsys_state __rcu *subsys[CGROUP_SUBSYS_COUNT];
+	struct cgroup_subsys_state __rcu *subsys[CGROUP_SUBSYS_MAIN_COUNT];
 
 	struct cgroup_root *root;
 
@@ -444,7 +481,7 @@ struct cgroup {
 	 * following lists all css_sets which point to this cgroup's css
 	 * for the given subsystem.
 	 */
-	struct list_head e_csets[CGROUP_SUBSYS_COUNT];
+	struct list_head e_csets[CGROUP_SUBSYS_MAIN_COUNT];
 
 	/*
 	 * If !threaded, self.  If threaded, it points to the nearest
@@ -490,10 +527,115 @@ struct cgroup {
 	/* Used to store internal freezer state */
 	struct cgroup_freezer_state freezer;
 
+#ifndef __GENKSYMS__
+	/* high 32 bits of the extension slots pointer (ABI-neutral padding) */
+	u32 ext_hi;
+#endif
+
 	/* ids of the ancestors at each level including self */
 	u64 ancestor_ids[];
 };
 
+/*
+ * Extension storage for cgroup subsystems beyond the original KMI.  Kept
+ * out of struct cgroup so its layout (and the module CRCs) stay identical
+ * to the GKI reference.
+ */
+struct cgroup_ext {
+	struct cgroup_subsys_state __rcu *subsys[CGROUP_SUBSYS_EXT_SLOTS];
+	struct list_head e_csets[CGROUP_SUBSYS_EXT_SLOTS];
+};
+
+#ifndef __GENKSYMS__
+static inline bool cgroup_ssid_is_ext(int ssid)
+{
+	return ssid >= CGROUP_SUBSYS_MAIN_COUNT;
+}
+
+static inline int cgroup_ext_index(int ssid)
+{
+	return ssid - CGROUP_SUBSYS_MAIN_COUNT;
+}
+
+static inline struct ext_css_set *css_set_to_ext(struct css_set *cset)
+{
+	/* struct css_set is the first member of struct ext_css_set */
+	return (struct ext_css_set *)cset;
+}
+
+static inline struct cgroup_subsys_state *
+css_set_get_subsys(struct css_set *cset, int ssid)
+{
+	if (cgroup_ssid_is_ext(ssid))
+		return css_set_to_ext(cset)->ext_subsys[cgroup_ext_index(ssid)];
+	return cset->subsys[ssid];
+}
+
+static inline void css_set_set_subsys(struct css_set *cset, int ssid,
+				      struct cgroup_subsys_state *css)
+{
+	if (cgroup_ssid_is_ext(ssid))
+		css_set_to_ext(cset)->ext_subsys[cgroup_ext_index(ssid)] = css;
+	else
+		cset->subsys[ssid] = css;
+}
+
+static inline struct list_head *css_set_e_cset_node(struct css_set *cset, int ssid)
+{
+	if (cgroup_ssid_is_ext(ssid))
+		return &css_set_to_ext(cset)->ext_e_cset_node[cgroup_ext_index(ssid)];
+	return &cset->e_cset_node[ssid];
+}
+
+static inline struct css_set *css_set_from_e_cset_node(struct list_head *node, int ssid)
+{
+	if (cgroup_ssid_is_ext(ssid))
+		return (struct css_set *)((char *)node -
+			offsetof(struct ext_css_set, ext_e_cset_node) -
+			cgroup_ext_index(ssid) * sizeof(struct list_head));
+	return (struct css_set *)((char *)node -
+		offsetof(struct css_set, e_cset_node) -
+		ssid * sizeof(struct list_head));
+}
+
+static inline struct cgroup_ext *cgroup_to_ext(struct cgroup *cgrp)
+{
+	u64 p = ((u64)cgrp->ext_hi << 32) | cgrp->ext_lo;
+
+	return (struct cgroup_ext *)(unsigned long)p;
+}
+
+static inline void cgroup_set_ext(struct cgroup *cgrp, struct cgroup_ext *ext)
+{
+	u64 p = (unsigned long)ext;
+
+	cgrp->ext_lo = (u32)p;
+	cgrp->ext_hi = (u32)(p >> 32);
+}
+
+static inline struct cgroup_subsys_state __rcu **
+cgroup_subsys_ptr(struct cgroup *cgrp, int ssid)
+{
+	if (cgroup_ssid_is_ext(ssid))
+		return &cgroup_to_ext(cgrp)->subsys[cgroup_ext_index(ssid)];
+	return &cgrp->subsys[ssid];
+}
+
+static inline struct list_head *cgroup_e_csets_ptr(struct cgroup *cgrp, int ssid)
+{
+	if (cgroup_ssid_is_ext(ssid))
+		return &cgroup_to_ext(cgrp)->e_csets[cgroup_ext_index(ssid)];
+	return &cgrp->e_csets[ssid];
+}
+#else
+#define css_set_get_subsys(cset, ssid)		(NULL)
+#define css_set_set_subsys(cset, ssid, css)	do { } while (0)
+#define css_set_e_cset_node(cset, ssid)		(NULL)
+#define css_set_from_e_cset_node(node, ssid)	(NULL)
+#define cgroup_subsys_ptr(cgrp, ssid)		(NULL)
+#define cgroup_e_csets_ptr(cgrp, ssid)		(NULL)
+#endif /* __GENKSYMS__ */
+
 /*
  * A cgroup_root represents the root of a cgroup hierarchy, and may be
  * associated with a kernfs_root to form an active hierarchy.  This is
diff --git a/include/linux/cgroup.h b/include/linux/cgroup.h
index 3c0b5b31a..f681238cc 100644
--- a/include/linux/cgroup.h
+++ b/include/linux/cgroup.h
@@ -474,7 +474,7 @@ extern spinlock_t css_set_lock;
  * synchronization rules are the same as task_css_set_check().
  */
 #define task_css_check(task, subsys_id, __c)				\
-	task_css_set_check((task), (__c))->subsys[(subsys_id)]
+	css_set_get_subsys(task_css_set_check((task), (__c)), (subsys_id))
 
 /**
  * task_css_set - obtain a task's css_set
@@ -542,7 +542,7 @@ task_get_css(struct task_struct *task, int subsys_id)
 static inline bool task_css_is_root(struct task_struct *task, int subsys_id)
 {
 	return task_css_check(task, subsys_id, true) ==
-		init_css_set.subsys[subsys_id];
+		css_set_get_subsys(&init_css_set, subsys_id);
 }
 
 static inline struct cgroup *task_cgroup(struct task_struct *task,
diff --git a/include/linux/cgroup_subsys.h b/include/linux/cgroup_subsys.h
index acb77dcff..07191d6a3 100644
--- a/include/linux/cgroup_subsys.h
+++ b/include/linux/cgroup_subsys.h
@@ -29,22 +29,10 @@ SUBSYS(io)
 SUBSYS(memory)
 #endif
 
-#if IS_ENABLED(CONFIG_CGROUP_DEVICE)
-SUBSYS(devices)
-#endif
-
 #if IS_ENABLED(CONFIG_CGROUP_FREEZER)
 SUBSYS(freezer)
 #endif
 
-#if IS_ENABLED(CONFIG_CGROUP_NET_CLASSID)
-SUBSYS(net_cls)
-#endif
-
-#if IS_ENABLED(CONFIG_CGROUP_PERF)
-SUBSYS(perf_event)
-#endif
-
 #if IS_ENABLED(CONFIG_CGROUP_NET_PRIO)
 SUBSYS(net_prio)
 #endif
@@ -53,10 +41,6 @@ SUBSYS(net_prio)
 SUBSYS(hugetlb)
 #endif
 
-#if IS_ENABLED(CONFIG_CGROUP_PIDS)
-SUBSYS(pids)
-#endif
-
 #if IS_ENABLED(CONFIG_CGROUP_RDMA)
 SUBSYS(rdma)
 #endif
@@ -68,6 +52,37 @@ SUBSYS(rdma)
 SUBSYS(debug)
 #endif
 
+/*
+ * Controllers added after the 5.10 KMI are kept at the end so that their
+ * subsystem ids are >= CGROUP_SUBSYS_MAIN_COUNT; their state lives in the
+ * ext structures instead of struct css_set / struct cgroup.
+ * CONFIG_CGROUP_DEBUG must stay disabled: it would shift this boundary.
+ *
+ * genksyms must not see these entries: they would change the
+ * enum cgroup_subsys_id members and CGROUP_SUBSYS_COUNT, which genksyms
+ * folds into the CRCs of symbols touching struct css_set / struct cgroup.
+ */
+#if IS_ENABLED(CONFIG_CGROUP_DEVICE) && !defined(__GENKSYMS__)
+SUBSYS(devices)
+#endif
+
+#if IS_ENABLED(CONFIG_CGROUP_PIDS) && !defined(__GENKSYMS__)
+SUBSYS(pids)
+#endif
+
+/*
+ * perf_event keeps the stock KMI: its cgrp pointer is split across two u32
+ * fields placed in stock layout holes in include/linux/perf_event.h, and
+ * those fields are hidden from genksyms.
+ */
+#if IS_ENABLED(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+SUBSYS(perf_event)
+#endif
+
+#if IS_ENABLED(CONFIG_CGROUP_NET_CLASSID) && !defined(__GENKSYMS__)
+SUBSYS(net_cls)
+#endif
+
 /*
  * DO NOT ADD ANY SUBSYSTEM WITHOUT EXPLICIT ACKS FROM CGROUP MAINTAINERS.
  */
diff --git a/include/linux/perf_event.h b/include/linux/perf_event.h
index 5cac2f291..d8c8d9049 100644
--- a/include/linux/perf_event.h
+++ b/include/linux/perf_event.h
@@ -725,11 +725,22 @@ struct perf_event {
 	/* mmap bits */
 	struct mutex			mmap_mutex;
 	atomic_t			mmap_count;
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+	/*
+	 * The stock layout has a 4-byte hole here.  Store the high half of
+	 * the cgroup pointer in it so the layout stays ABI-compatible; the
+	 * low half lives in the hole after rcu_pending.  See get_cgrp().
+	 */
+	u32				cgrp_high;
+#endif
 
 	struct perf_buffer		*rb;
 	struct list_head		rb_entry;
 	unsigned long			rcu_batches;
 	int				rcu_pending;
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+	u32				cgrp_low;
+#endif
 
 	/* poll related */
 	wait_queue_head_t		waitq;
@@ -774,10 +785,6 @@ struct perf_event {
 #endif
 #endif
 
-#ifdef CONFIG_CGROUP_PERF
-	struct perf_cgroup		*cgrp; /* cgroup event is attach to */
-#endif
-
 #ifdef CONFIG_SECURITY
 	void *security;
 #endif
@@ -785,6 +792,29 @@ struct perf_event {
 #endif /* CONFIG_PERF_EVENTS */
 };
 
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+/*
+ * struct perf_event has no free pointer-sized field.  Keep the cgroup
+ * pointer split across the two 4-byte holes of the stock layout (after
+ * mmap_count and rcu_pending) so that both the runtime layout and the
+ * genksyms CRCs stay identical to a kernel built without CGROUP_PERF.
+ */
+static inline struct perf_cgroup *get_cgrp(const struct perf_event *event)
+{
+	u64 val = ((u64)READ_ONCE(event->cgrp_high) << 32) |
+		  READ_ONCE(event->cgrp_low);
+
+	return (struct perf_cgroup *)(unsigned long)val;
+}
+
+static inline void set_cgrp(struct perf_event *event, struct perf_cgroup *cgrp)
+{
+	u64 val = (u64)(unsigned long)cgrp;
+
+	WRITE_ONCE(event->cgrp_high, (u32)(val >> 32));
+	WRITE_ONCE(event->cgrp_low, (u32)val);
+}
+#endif
 
 struct perf_event_groups {
 	struct rb_root	tree;
@@ -846,7 +876,8 @@ struct perf_event_context {
 	u64				parent_gen;
 	u64				generation;
 	int				pin_count;
-#ifdef CONFIG_CGROUP_PERF
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+	/* Fills the 4-byte hole before task_ctx_data: layout stays stock. */
 	int				nr_cgroups;	 /* cgroup evts */
 #endif
 	void				*task_ctx_data; /* pmu specific data */
@@ -873,7 +904,8 @@ struct perf_cpu_context {
 	ktime_t				hrtimer_interval;
 	unsigned int			hrtimer_active;
 
-#ifdef CONFIG_CGROUP_PERF
+#if defined(CONFIG_CGROUP_PERF) && !defined(__GENKSYMS__)
+	/* Internal type: no exported symbol uses struct perf_cpu_context. */
 	struct perf_cgroup		*cgrp;
 	struct list_head		cgrp_cpuctx_entry;
 #endif
diff --git a/kernel/cgroup/cgroup-v1.c b/kernel/cgroup/cgroup-v1.c
index 3a5941c28..e4e3a4c82 100644
--- a/kernel/cgroup/cgroup-v1.c
+++ b/kernel/cgroup/cgroup-v1.c
@@ -1218,6 +1218,16 @@ static int cgroup1_root_to_use(struct fs_context *fc)
 	if (!root)
 		return -ENOMEM;
 
