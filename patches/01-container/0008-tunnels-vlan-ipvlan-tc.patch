From 0864bc62680e6fc93910a86e95792060b781c8d6 Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Sun, 25 Oct 2026 19:46:00 +0800
Subject: [PATCH] phase6: enable tunnels, virtual NICs and tc; ABI-safe VLAN
 and IPVLAN

- Enable the phase 6 tunnel/tc set plus VLAN_8021Q,
  BRIDGE_VLAN_FILTERING and IPVLAN (IPVLAN_L3S selects
  NET_L3_MASTER_DEV).
- struct net_device: l3mdev_ops and vlan_info overlay KABI reserves 1
  and 2 as genksyms-hidden unions; size and stock offsets unchanged.
- struct netns_ipv4: the three l3mdev sysctls fill the 32-byte
  alignment hole before tcp_death_row, hidden from genksyms.
- Gates: 7298-symbol symvers diff 0, 355 vendor modules pass,
  net_device 2496, netns_ipv4 960, struct net 4672.
- Device: VLAN and IPVLAN interfaces created and removed successfully.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 arch/arm64/configs/gki_defconfig | 55 ++++++++++++++++++++++++++++++++
 include/linux/netdevice.h        | 28 ++++++++++++----
 include/net/netns/ipv4.h         | 19 ++++++-----
 3 files changed, 86 insertions(+), 16 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index a7da15783..30d35cc1f 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -797,3 +797,58 @@ CONFIG_IP_VS_FTP=y
 CONFIG_IP_VS_PE_SIP=y
 CONFIG_NETFILTER_XT_MATCH_IPVS=y
 CONFIG_IP_SCTP=y
+# Phase 6: tunnels / virtual NICs / tc.
+# Skipped on purpose: NET_CLS_ROUTE4 (selects IP_ROUTE_CLASSID, grows
+# netns_ipv4), MPLS_IPTUNNEL (needs MPLS, grows struct net),
+# IPV6_IOAM6_LWTUNNEL (not in 5.10).
+# ABI: vlan_info overlays struct net_device KABI reserve 2; l3mdev_ops
+# (IPVLAN selects IPVLAN_L3S -> NET_L3_MASTER_DEV) overlays reserve 1;
+# the three l3mdev sysctls fill the 32-byte alignment hole in
+# netns_ipv4 before tcp_death_row.
+CONFIG_VLAN_8021Q=y
+CONFIG_BRIDGE_VLAN_FILTERING=y
+CONFIG_IPVLAN=y
+CONFIG_VXLAN=y
+CONFIG_MACVLAN=y
+CONFIG_L2TP_V3=y
+CONFIG_L2TP_IP=y
+CONFIG_L2TP_ETH=y
+CONFIG_NET_FOU=y
+CONFIG_NET_FOU_IP_TUNNELS=y
+CONFIG_NET_IPGRE_BROADCAST=y
+CONFIG_IPV6_SEG6_LWTUNNEL=y
+CONFIG_IPV6_RPL_LWTUNNEL=y
+CONFIG_NET_CLS_FLOWER=y
+CONFIG_NET_ACT_SAMPLE=y
+CONFIG_NET_ACT_NAT=y
+CONFIG_NET_ACT_PEDIT=y
+CONFIG_NET_ACT_SIMP=y
+CONFIG_NET_ACT_CSUM=y
+CONFIG_NET_ACT_MPLS=y
+CONFIG_NET_ACT_VLAN=y
+CONFIG_NET_ACT_CONNMARK=y
+CONFIG_NET_ACT_CTINFO=y
+CONFIG_NET_ACT_SKBMOD=y
+CONFIG_NET_ACT_IFE=y
+CONFIG_NET_ACT_TUNNEL_KEY=y
+CONFIG_NET_ACT_GATE=y
+CONFIG_NET_SCH_HFSC=y
+CONFIG_NET_SCH_RED=y
+CONFIG_NET_SCH_SFB=y
+CONFIG_NET_SCH_TEQL=y
+CONFIG_NET_SCH_CBS=y
+CONFIG_NET_SCH_ETF=y
+CONFIG_NET_SCH_TAPRIO=y
+CONFIG_NET_SCH_GRED=y
+CONFIG_NET_SCH_DRR=y
+CONFIG_NET_SCH_MQPRIO=y
+CONFIG_NET_SCH_SKBPRIO=y
+CONFIG_NET_SCH_CHOKE=y
+CONFIG_NET_SCH_QFQ=y
+CONFIG_NET_SCH_CAKE=y
+CONFIG_NET_SCH_HHF=y
+CONFIG_NET_SCH_PIE=y
+CONFIG_NET_SCH_PLUG=y
+CONFIG_NET_SCH_ETS=y
+CONFIG_NET_SCH_DEFAULT=y
+CONFIG_NET_SCH_FQ_PIE=y
diff --git a/include/linux/netdevice.h b/include/linux/netdevice.h
index 3d61f6887..c1f54996a 100644
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -1975,9 +1975,6 @@ struct net_device {
 #endif
 	const struct net_device_ops *netdev_ops;
 	const struct ethtool_ops *ethtool_ops;
-#ifdef CONFIG_NET_L3_MASTER_DEV
-	const struct l3mdev_ops	*l3mdev_ops;
-#endif
 #if IS_ENABLED(CONFIG_IPV6)
 	const struct ndisc_ops *ndisc_ops;
 #endif
@@ -2052,9 +2049,6 @@ struct net_device {
 
 	/* Protocol-specific pointers */
 
-#if IS_ENABLED(CONFIG_VLAN_8021Q)
-	struct vlan_info __rcu	*vlan_info;
-#endif
 #if IS_ENABLED(CONFIG_NET_DSA)
 	struct dsa_port		*dsa_ptr;
 #endif
@@ -2224,8 +2218,30 @@ struct net_device {
 	/* protected by rtnl_lock */
 	struct bpf_xdp_entity	xdp_state[__MAX_XDP_MODE];
 
+#if defined(CONFIG_NET_L3_MASTER_DEV) && !defined(__GENKSYMS__)
+	union {
+		struct {
+			ANDROID_KABI_RESERVE(1);
+		};
+		struct {
+			const struct l3mdev_ops	*l3mdev_ops;
+		};
+	};
+#else
 	ANDROID_KABI_RESERVE(1);
+#endif
+#if IS_ENABLED(CONFIG_VLAN_8021Q) && !defined(__GENKSYMS__)
+	union {
+		struct {
+			ANDROID_KABI_RESERVE(2);
+		};
+		struct {
+			struct vlan_info __rcu	*vlan_info;
+		};
+	};
+#else
 	ANDROID_KABI_RESERVE(2);
+#endif
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
 	ANDROID_KABI_RESERVE(5);
diff --git a/include/net/netns/ipv4.h b/include/net/netns/ipv4.h
index fb94551d0..baf785b16 100644
--- a/include/net/netns/ipv4.h
+++ b/include/net/netns/ipv4.h
@@ -106,9 +106,6 @@ struct netns_ipv4 {
 	/* Shall we try to damage output packets if routing dev changes? */
 	int sysctl_ip_dynaddr;
 	int sysctl_ip_early_demux;
-#ifdef CONFIG_NET_L3_MASTER_DEV
-	int sysctl_raw_l3mdev_accept;
-#endif
 	int sysctl_tcp_early_demux;
 	int sysctl_udp_early_demux;
 
@@ -116,9 +113,6 @@ struct netns_ipv4 {
 
 	int sysctl_fwmark_reflect;
 	int sysctl_tcp_fwmark_accept;
-#ifdef CONFIG_NET_L3_MASTER_DEV
-	int sysctl_tcp_l3mdev_accept;
-#endif
 	int sysctl_tcp_mtu_probing;
 	int sysctl_tcp_mtu_probe_floor;
 	int sysctl_tcp_base_mss;
@@ -175,6 +169,15 @@ struct netns_ipv4 {
 	int sysctl_tcp_comp_sack_nr;
 	unsigned long sysctl_tcp_comp_sack_delay_ns;
 	unsigned long sysctl_tcp_comp_sack_slack_ns;
+#if defined(CONFIG_NET_L3_MASTER_DEV) && !defined(__GENKSYMS__)
+	/*
+	 * Stock-layout anchor: these live in the 32-byte alignment hole
+	 * before tcp_death_row (64-byte aligned), so no offset moves.
+	 */
+	int sysctl_raw_l3mdev_accept;
+	int sysctl_tcp_l3mdev_accept;
+	int sysctl_udp_l3mdev_accept;
+#endif
 	struct inet_timewait_death_row tcp_death_row;
 	int sysctl_max_syn_backlog;
 	int sysctl_tcp_fastopen;
@@ -189,10 +192,6 @@ struct netns_ipv4 {
 	int sysctl_udp_wmem_min;
 	int sysctl_udp_rmem_min;
 
-#ifdef CONFIG_NET_L3_MASTER_DEV
-	int sysctl_udp_l3mdev_accept;
-#endif
-
 	int sysctl_igmp_max_memberships;
 	int sysctl_igmp_max_msf;
 	int sysctl_igmp_llm_reports;
