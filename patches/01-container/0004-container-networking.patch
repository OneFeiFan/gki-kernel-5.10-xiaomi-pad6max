-#endif
 #if IS_ENABLED(CONFIG_NET_DSA)
 	struct dsa_port		*dsa_ptr;
 #endif
@@ -2188,6 +2182,7 @@ struct net_device {
 
 	/* for setting kernel sock attribute on TCP connection setup */
 #define GSO_MAX_SIZE		65536
+#define GSO_LEGACY_MAX_SIZE	65536u
 	unsigned int		gso_max_size;
 #define GSO_MAX_SEGS		65535
 	u16			gso_max_segs;
@@ -2224,8 +2219,30 @@ struct net_device {
 	/* protected by rtnl_lock */
 	struct bpf_xdp_entity	xdp_state[__MAX_XDP_MODE];
 
+#if defined(CONFIG_NET_L3_MASTER_DEV) && !defined(__GENKSYMS__)
+	union {
+		struct {
+			ANDROID_KABI_RESERVE(1);
+		};
+		struct {
+			const struct l3mdev_ops	*l3mdev_ops;
+		};
+	};
+#else
 	ANDROID_KABI_RESERVE(1);
+#endif
+#if IS_ENABLED(CONFIG_VLAN_8021Q) && !defined(__GENKSYMS__)
+	union {
+		struct {
+			ANDROID_KABI_RESERVE(2);
+		};
+		struct {
+			struct vlan_info __rcu	*vlan_info;
+		};
+	};
+#else
 	ANDROID_KABI_RESERVE(2);
+#endif
 	ANDROID_KABI_RESERVE(3);
 	ANDROID_KABI_RESERVE(4);
 	ANDROID_KABI_RESERVE(5);
diff --git a/include/linux/netfilter.h b/include/linux/netfilter.h
index 819aace..99ea098 100644
--- a/include/linux/netfilter.h
+++ b/include/linux/netfilter.h
@@ -237,7 +237,7 @@ static inline int nf_hook(u_int8_t pf, unsigned int hook, struct net *net,
 		break;
 	case NFPROTO_BRIDGE:
 #ifdef CONFIG_NETFILTER_FAMILY_BRIDGE
-		hook_head = rcu_dereference(net->nf.hooks_bridge[hook]);
+		hook_head = rcu_dereference(net->nf.additional_info->hooks_bridge[hook]);
 #endif
 		break;
 	default:
diff --git a/include/linux/skbuff.h b/include/linux/skbuff.h
