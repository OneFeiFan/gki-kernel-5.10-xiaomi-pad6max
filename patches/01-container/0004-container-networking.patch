diff --git a/include/net/net_namespace.h b/include/net/net_namespace.h
index 82cfc50..81a43d9 100644
--- a/include/net/net_namespace.h
+++ b/include/net/net_namespace.h
@@ -123,6 +123,23 @@ struct net {
 	struct netns_packet	packet;
 	struct netns_unix	unx;
 	struct netns_nexthop	nexthop;
+#if (defined(CONFIG_NF_TABLES) || defined(CONFIG_NF_TABLES_MODULE)) && !defined(__GENKSYMS__)
+	/*
+	 * The stock layout has 40 bytes of padding between nexthop and ipv4
+	 * (ipv4 is cacheline aligned).  netns_nftables is 16 bytes and fits
+	 * there, so struct net keeps its original layout while genksyms
+	 * still sees the stock declaration.
+	 */
+	struct netns_nftables	nft;
+#endif
+#if IS_ENABLED(CONFIG_IP_VS) && !defined(__GENKSYMS__)
+	/* Fills stock layout padding (offset 680). */
+	struct netns_ipvs	*ipvs;
+#endif
+#if IS_ENABLED(CONFIG_IP_SCTP) && !defined(__GENKSYMS__)
+	/* Fills stock layout padding (offset 688); see net_sctp(). */
+	struct netns_sctp	*sctp_ext;
+#endif
 	struct netns_ipv4	ipv4;
 #if IS_ENABLED(CONFIG_IPV6)
 	struct netns_ipv6	ipv6;
@@ -130,9 +147,6 @@ struct net {
 #if IS_ENABLED(CONFIG_IEEE802154_6LOWPAN)
 	struct netns_ieee802154_lowpan	ieee802154_lowpan;
 #endif
-#if defined(CONFIG_IP_SCTP) || defined(CONFIG_IP_SCTP_MODULE)
-	struct netns_sctp	sctp;
-#endif
 #if defined(CONFIG_IP_DCCP) || defined(CONFIG_IP_DCCP_MODULE)
 	struct netns_dccp	dccp;
 #endif
@@ -142,9 +156,6 @@ struct net {
 #if defined(CONFIG_NF_CONNTRACK) || defined(CONFIG_NF_CONNTRACK_MODULE)
 	struct netns_ct		ct;
 #endif
-#if defined(CONFIG_NF_TABLES) || defined(CONFIG_NF_TABLES_MODULE)
-	struct netns_nftables	nft;
-#endif
 #if IS_ENABLED(CONFIG_NF_DEFRAG_IPV6)
 	struct netns_nf_frag	nf_frag;
 	struct ctl_table_header *nf_frag_frags_hdr;
@@ -173,9 +184,6 @@ struct net {
 
 	atomic64_t		net_cookie; /* written once */
 
-#if IS_ENABLED(CONFIG_IP_VS)
-	struct netns_ipvs	*ipvs;
-#endif
 #if IS_ENABLED(CONFIG_MPLS)
 	struct netns_mpls	mpls;
 #endif
@@ -191,6 +199,14 @@ struct net {
 	struct sock		*diag_nlsk;
 } __randomize_layout;
 
+#if IS_ENABLED(CONFIG_IP_SCTP)
+/*
+ * SCTP per-net state is allocated separately (see sctp_defaults_init) and
+ * reached through sctp_ext, so struct net keeps its stock layout.
+ */
+#define net_sctp(__net)	(*(__net)->sctp_ext)
+#endif
+
 #include <linux/seq_file_net.h>
 
 /* Init's network namespace */
diff --git a/include/net/netfilter/nf_conntrack_extend.h b/include/net/netfilter/nf_conntrack_extend.h
index e1e5883..b93d406 100644
--- a/include/net/netfilter/nf_conntrack_extend.h
+++ b/include/net/netfilter/nf_conntrack_extend.h
@@ -25,7 +25,13 @@ enum nf_ct_ext_id {
 #ifdef CONFIG_NF_CONNTRACK_LABELS
 	NF_CT_EXT_LABELS,
 #endif
-#if IS_ENABLED(CONFIG_NETFILTER_SYNPROXY)
+/*
+ * The extra enum value shifts NF_CT_EXT_NUM (5 -> 6), which genksyms folds
+ * into the CRCs of symbols whose types reach struct nf_ct_ext.  Hide it from
+ * genksyms so those CRCs stay identical to a kernel without SYNPROXY; the
+ * runtime-only growth of struct nf_ct_ext is internal to conntrack.
+ */
+#if IS_ENABLED(CONFIG_NETFILTER_SYNPROXY) && !defined(__GENKSYMS__)
 	NF_CT_EXT_SYNPROXY,
 #endif
 	NF_CT_EXT_NUM,
diff --git a/include/net/netfilter/nf_queue.h b/include/net/netfilter/nf_queue.h
index 779327e..2ac48b4 100644
--- a/include/net/netfilter/nf_queue.h
+++ b/include/net/netfilter/nf_queue.h
@@ -14,7 +14,11 @@ struct nf_queue_entry {
 	struct sk_buff		*skb;
 	unsigned int		id;
 	unsigned int		hook_index;	/* index in hook_entries->hook[] */
-#if IS_ENABLED(CONFIG_BRIDGE_NETFILTER)
+#if IS_ENABLED(CONFIG_BRIDGE_NETFILTER) && !defined(__GENKSYMS__)
+	/*
+	 * Internal to nf_queue: keep it invisible to genksyms so the CRCs of
+	 * symbols whose types reach nf_queue_entry stay identical to stock.
+	 */
 	struct net_device	*bridge_dev;
 	struct net_device	*physin;
 	struct net_device	*physout;
diff --git a/include/net/netns/ipv4.h b/include/net/netns/ipv4.h
index fb94551..b240834 100644
--- a/include/net/netns/ipv4.h
+++ b/include/net/netns/ipv4.h
@@ -11,6 +11,8 @@
 #include <linux/rcupdate.h>
 #include <linux/siphash.h>
 #include <linux/android_kabi.h>
+#include <linux/build_bug.h>
+#include <linux/stddef.h>
 
 struct tcpm_hash_bucket;
 struct ctl_table_header;
@@ -106,9 +108,6 @@ struct netns_ipv4 {
 	/* Shall we try to damage output packets if routing dev changes? */
 	int sysctl_ip_dynaddr;
 	int sysctl_ip_early_demux;
-#ifdef CONFIG_NET_L3_MASTER_DEV
-	int sysctl_raw_l3mdev_accept;
-#endif
 	int sysctl_tcp_early_demux;
 	int sysctl_udp_early_demux;
 
@@ -116,9 +115,6 @@ struct netns_ipv4 {
 
 	int sysctl_fwmark_reflect;
 	int sysctl_tcp_fwmark_accept;
-#ifdef CONFIG_NET_L3_MASTER_DEV
-	int sysctl_tcp_l3mdev_accept;
-#endif
 	int sysctl_tcp_mtu_probing;
 	int sysctl_tcp_mtu_probe_floor;
 	int sysctl_tcp_base_mss;
@@ -175,6 +171,15 @@ struct netns_ipv4 {
 	int sysctl_tcp_comp_sack_nr;
 	unsigned long sysctl_tcp_comp_sack_delay_ns;
 	unsigned long sysctl_tcp_comp_sack_slack_ns;
+#if defined(CONFIG_NET_L3_MASTER_DEV) && !defined(__GENKSYMS__)
+	/*
+	 * Stock-layout anchor: these live in the 32-byte alignment hole
+	 * before tcp_death_row (64-byte aligned), so no offset moves.
+	 */
+	int sysctl_raw_l3mdev_accept;
+	int sysctl_tcp_l3mdev_accept;
+	int sysctl_udp_l3mdev_accept;
+#endif
 	struct inet_timewait_death_row tcp_death_row;
 	int sysctl_max_syn_backlog;
 	int sysctl_tcp_fastopen;
@@ -189,10 +194,6 @@ struct netns_ipv4 {
 	int sysctl_udp_wmem_min;
 	int sysctl_udp_rmem_min;
 
-#ifdef CONFIG_NET_L3_MASTER_DEV
-	int sysctl_udp_l3mdev_accept;
-#endif
-
 	int sysctl_igmp_max_memberships;
 	int sysctl_igmp_max_msf;
 	int sysctl_igmp_llm_reports;
@@ -232,4 +233,14 @@ struct netns_ipv4 {
 
 	ANDROID_KABI_RESERVE(1);
 };
+
+/*
+ * KMI pins: the l3mdev sysctls added under CONFIG_NET_L3_MASTER_DEV live
+ * in the alignment hole before tcp_death_row, so the stock offsets are
+ * preserved. Keep it that way.
+ */
+#ifndef __GENKSYMS__
+static_assert(offsetof(struct netns_ipv4, tcp_death_row) == 640);
+static_assert(sizeof(struct netns_ipv4) == 960);
+#endif
 #endif
diff --git a/include/net/netns/netfilter.h b/include/net/netns/netfilter.h
index 6ec6887..5fa5207 100644
--- a/include/net/netns/netfilter.h
+++ b/include/net/netns/netfilter.h
@@ -9,6 +9,16 @@ struct proc_dir_entry;
 struct nf_logger;
 struct nf_queue_handler;
 
+#ifdef CONFIG_NETFILTER_FAMILY_BRIDGE
+/*
+ * Bridge hooks live outside struct netns_nf so its layout (and the genksyms
+ * CRCs of the symbols reaching it) stays identical to the stock kernel.
+ */
+struct netns_nf_additional_info {
+	struct nf_hook_entries __rcu *hooks_bridge[NF_INET_NUMHOOKS];
+};
+#endif
+
 struct netns_nf {
 #if defined CONFIG_PROC_FS
 	struct proc_dir_entry *proc_netfilter;
@@ -23,9 +33,6 @@ struct netns_nf {
 #ifdef CONFIG_NETFILTER_FAMILY_ARP
 	struct nf_hook_entries __rcu *hooks_arp[NF_ARP_NUMHOOKS];
 #endif
-#ifdef CONFIG_NETFILTER_FAMILY_BRIDGE
-	struct nf_hook_entries __rcu *hooks_bridge[NF_INET_NUMHOOKS];
-#endif
 #if IS_ENABLED(CONFIG_NF_DEFRAG_IPV4)
 	bool			defrag_ipv4;
 #endif
@@ -33,6 +40,18 @@ struct netns_nf {
 	bool			defrag_ipv6;
 #endif
 
+#if defined(CONFIG_NETFILTER_FAMILY_BRIDGE) && !defined(__GENKSYMS__)
+	/*
+	 * Reuse the old KABI reserve slot for a pointer to the per-net bridge
+	 * hook array.  Size (248) and offset (240) stay unchanged; genksyms
+	 * still sees the stock reserve field.
+	 */
+	union {
+		struct netns_nf_additional_info *additional_info;
+		ANDROID_KABI_RESERVE(1);
+	};
+#else
 	ANDROID_KABI_RESERVE(1);
+#endif
 };
 #endif
diff --git a/include/net/netns/sctp.h b/include/net/netns/sctp.h
index d8d02e4..4e745bd 100644
--- a/include/net/netns/sctp.h
+++ b/include/net/netns/sctp.h
@@ -161,6 +161,9 @@ struct netns_sctp {
 
 	/* Threshold for autoclose timeout, in seconds. */
 	unsigned long max_autoclose;
+
+	/* Back pointer to the owning netns (SCTP state is dynamically alloc'd). */
