diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 7611835..b3a9c02 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -704,11 +704,154 @@ CONFIG_POSIX_MQUEUE=y
 CONFIG_IPC_NS=y
 CONFIG_USER_NS=y
 CONFIG_DEVTMPFS=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+CONFIG_NETFILTER_XT_TARGET_LOG=y
+CONFIG_NETFILTER_XT_MATCH_RECENT=y
+CONFIG_IP_SET=y
+CONFIG_IP_SET_HASH_IP=y
+CONFIG_IP_SET_HASH_NET=y
+CONFIG_NETFILTER_XT_SET=y
 CONFIG_CGROUP_DEVICE=y
 CONFIG_CGROUP_PIDS=y
 # CGROUP_PERF keeps the stock KMI via the cgrp split in linux/perf_event.h.
 CONFIG_CGROUP_PERF=y
 CONFIG_CGROUP_NET_CLASSID=y
+# nftables (Docker requires NF_TABLES; NFT_* is the reference "full set").
+# Deferred to phase 4 (bridge): NF_TABLES_BRIDGE selects
+# NETFILTER_FAMILY_BRIDGE, which adds hooks_bridge[5] to struct netns_nf
+# (+40 bytes) and changes the struct net layout.
+# Disabled on purpose: CONFIG_NFT_FLOW_OFFLOAD (selects NF_FLOW_TABLE, which
+# adds struct netns_ft to struct net; not needed for Docker).
+CONFIG_NF_TABLES=y
+CONFIG_NF_TABLES_INET=y
+CONFIG_NF_TABLES_NETDEV=y
+CONFIG_NF_TABLES_IPV4=y
+CONFIG_NF_TABLES_ARP=y
+CONFIG_NF_TABLES_IPV6=y
+CONFIG_NFT_NUMGEN=y
+CONFIG_NFT_CT=y
+CONFIG_NFT_CONNLIMIT=y
+CONFIG_NFT_LIMIT=y
+CONFIG_NFT_MASQ=y
+CONFIG_NFT_REDIR=y
+CONFIG_NFT_TUNNEL=y
+CONFIG_NFT_QUEUE=y
+CONFIG_NFT_QUOTA=y
+CONFIG_NFT_REJECT=y
+CONFIG_NFT_COMPAT=y
+CONFIG_NFT_HASH=y
+CONFIG_NFT_XFRM=y
+CONFIG_NFT_SOCKET=y
+CONFIG_NFT_OSF=y
+CONFIG_NFT_TPROXY=y
+CONFIG_NFT_SYNPROXY=y
+CONFIG_NFT_NAT=y
+CONFIG_NFT_FIB=y
+CONFIG_NFT_FIB_IPV4=y
+CONFIG_NFT_FIB_IPV6=y
+CONFIG_NFT_LOG=y
+CONFIG_NFT_FIB_INET=y
+CONFIG_NFT_DUP_NETDEV=y
+CONFIG_NFT_FWD_NETDEV=y
+CONFIG_NFT_FIB_NETDEV=y
+CONFIG_NFT_DUP_IPV4=y
+CONFIG_NFT_DUP_IPV6=y
+CONFIG_NFT_COUNTER=y
+CONFIG_NFT_OBJREF=y
+CONFIG_NFT_REJECT_INET=y
+CONFIG_NFT_REJECT_IPV4=y
+CONFIG_NFT_REJECT_IPV6=y
 # Phase 4: bridge netfilter + IPv6 NAT.  Ebtables and VLAN filtering are
+# deferred (ebtables needs 3 pointers in struct netns_xt; VLAN filtering
+# depends on VLAN_8021Q which arrives in phase 6).
+CONFIG_BRIDGE_NETFILTER=y
+CONFIG_NF_CONNTRACK_BRIDGE=y
+CONFIG_NF_TABLES_BRIDGE=y
+CONFIG_NFT_BRIDGE_META=y
+CONFIG_NFT_BRIDGE_REJECT=y
+CONFIG_IP6_NF_NAT=y
+CONFIG_IP6_NF_TARGET_MASQUERADE=y
 # Phase 5: IPVS + SCTP.  IP_VS_TWOS does not exist in 5.10 (added later).
+CONFIG_IP_VS=y
+CONFIG_IP_VS_IPV6=y
+CONFIG_IP_VS_PROTO_TCP=y
+CONFIG_IP_VS_PROTO_UDP=y
+CONFIG_IP_VS_PROTO_SCTP=y
+CONFIG_IP_VS_PROTO_ESP=y
+CONFIG_IP_VS_PROTO_AH=y
+CONFIG_IP_VS_RR=y
+CONFIG_IP_VS_WRR=y
+CONFIG_IP_VS_LC=y
+CONFIG_IP_VS_WLC=y
+CONFIG_IP_VS_FO=y
+CONFIG_IP_VS_OVF=y
+CONFIG_IP_VS_LBLC=y
+CONFIG_IP_VS_LBLCR=y
+CONFIG_IP_VS_DH=y
+CONFIG_IP_VS_SH=y
+CONFIG_IP_VS_SED=y
+CONFIG_IP_VS_NQ=y
+CONFIG_IP_VS_MH=y
+CONFIG_IP_VS_NFCT=y
+CONFIG_IP_VS_FTP=y
+CONFIG_IP_VS_PE_SIP=y
+CONFIG_NETFILTER_XT_MATCH_IPVS=y
+CONFIG_IP_SCTP=y
 # Phase 6: tunnels / virtual NICs / tc.
+# Skipped on purpose: NET_CLS_ROUTE4 (selects IP_ROUTE_CLASSID, grows
+# netns_ipv4), MPLS_IPTUNNEL (needs MPLS, grows struct net),
+# IPV6_IOAM6_LWTUNNEL (not in 5.10).
+# ABI: vlan_info overlays struct net_device KABI reserve 2; l3mdev_ops
+# (IPVLAN selects IPVLAN_L3S -> NET_L3_MASTER_DEV) overlays reserve 1;
+# the three l3mdev sysctls fill the 32-byte alignment hole in
+# netns_ipv4 before tcp_death_row.
+CONFIG_VLAN_8021Q=y
+CONFIG_BRIDGE_VLAN_FILTERING=y
+CONFIG_IPVLAN=y
+CONFIG_VXLAN=y
+CONFIG_MACVLAN=y
+CONFIG_L2TP_V3=y
+CONFIG_L2TP_IP=y
+CONFIG_L2TP_ETH=y
+CONFIG_NET_FOU=y
+CONFIG_NET_FOU_IP_TUNNELS=y
+CONFIG_NET_IPGRE_BROADCAST=y
+CONFIG_IPV6_SEG6_LWTUNNEL=y
+CONFIG_IPV6_RPL_LWTUNNEL=y
+CONFIG_NET_CLS_FLOWER=y
+CONFIG_NET_ACT_SAMPLE=y
+CONFIG_NET_ACT_NAT=y
+CONFIG_NET_ACT_PEDIT=y
+CONFIG_NET_ACT_SIMP=y
+CONFIG_NET_ACT_CSUM=y
+CONFIG_NET_ACT_MPLS=y
+CONFIG_NET_ACT_VLAN=y
+CONFIG_NET_ACT_CONNMARK=y
+CONFIG_NET_ACT_CTINFO=y
+CONFIG_NET_ACT_SKBMOD=y
+CONFIG_NET_ACT_IFE=y
+CONFIG_NET_ACT_TUNNEL_KEY=y
+CONFIG_NET_ACT_GATE=y
+CONFIG_NET_SCH_HFSC=y
+CONFIG_NET_SCH_RED=y
+CONFIG_NET_SCH_SFB=y
+CONFIG_NET_SCH_TEQL=y
+CONFIG_NET_SCH_CBS=y
+CONFIG_NET_SCH_ETF=y
+CONFIG_NET_SCH_TAPRIO=y
+CONFIG_NET_SCH_GRED=y
+CONFIG_NET_SCH_DRR=y
+CONFIG_NET_SCH_MQPRIO=y
+CONFIG_NET_SCH_SKBPRIO=y
+CONFIG_NET_SCH_CHOKE=y
+CONFIG_NET_SCH_QFQ=y
+CONFIG_NET_SCH_CAKE=y
+CONFIG_NET_SCH_HHF=y
+CONFIG_NET_SCH_PIE=y
+CONFIG_NET_SCH_PLUG=y
+CONFIG_NET_SCH_ETS=y
+CONFIG_NET_SCH_DEFAULT=y
+CONFIG_NET_SCH_FQ_PIE=y
+
+# Phase 7: block throttle, net classifier, checkpoint, Btrfs.
+CONFIG_NET_CLS_CGROUP=y
diff --git a/include/linux/netdevice.h b/include/linux/netdevice.h
index 3d61f68..721dd79 100644
--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -1975,9 +1975,6 @@ struct net_device {
 #endif
