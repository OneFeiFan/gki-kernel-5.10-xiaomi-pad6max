From 1798637491609b0d68cddabea8e42be2b28d84d8 Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Sun, 25 Oct 2026 18:28:55 +0800
Subject: [PATCH] GKI: enable nftables with an ABI-safe struct net placement

Enable the nftables framework and 39 CONFIG_NFT_* expression options.
Enabling NF_TABLES adds struct netns_nftables to struct net, and
NETFILTER_FAMILY_BRIDGE would add hooks_bridge to struct netns_nf, both
changing the layout and genksyms CRCs of struct net.

Keep the stock layout and CRCs:

- struct net: place netns_nftables in the 40-byte padding between
  netns_nexthop and netns_ipv4 (offset 664); ipv4 stays at 704 and the
  struct stays 4672 bytes
- hide the new member from genksyms; BUILD_BUG_ON the offsets and size
- hide the extra NF_CT_EXT_SYNPROXY enum value from genksyms; it would
  otherwise shift NF_CT_EXT_NUM from 5 to 6 and change the CRCs of the
  flow dissector and nf_ct_delete
- defer NF_TABLES_BRIDGE/NFT_BRIDGE_META/NFT_BRIDGE_REJECT to phase 4:
  NETFILTER_FAMILY_BRIDGE adds hooks_bridge[5] to struct netns_nf
- keep NFT_FLOW_OFFLOAD off: NF_FLOW_TABLE would add netns_ft to struct net

Validated on device: 7298/7298 symbol CRCs identical, 355/355 vendor
modules match, kernel boots, nf_tables symbols present, 426 modules load.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 arch/arm64/configs/gki_defconfig            | 45 +++++++++++++++++++++
 include/net/net_namespace.h                 | 12 ++++--
 include/net/netfilter/nf_conntrack_extend.h |  8 +++-
 net/netfilter/nf_tables_api.c               |  6 +++
 4 files changed, 67 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 7d759b1f4..e7f29c05a 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -716,3 +716,48 @@ CONFIG_CGROUP_PIDS=y
 # CGROUP_PERF keeps the stock KMI via the cgrp split in linux/perf_event.h.
 CONFIG_CGROUP_PERF=y
 CONFIG_CGROUP_NET_CLASSID=y
+# nftables (Docker requires NF_TABLES; NFT_* is the reference "full set").
+# Deferred to phase 4 (bridge): NF_TABLES_BRIDGE selects
+# NETFILTER_FAMILY_BRIDGE, which adds hooks_bridge[5] to struct netns_nf
+# (+40 bytes) and changes the struct net layout.
+# Disabled on purpose: CONFIG_NFT_FLOW_OFFLOAD (selects NF_FLOW_TABLE, which
+# adds struct netns_ft to struct net; not needed for Docker).
+CONFIG_NF_TABLES=y
+CONFIG_NF_TABLES_INET=y
+CONFIG_NF_TABLES_NETDEV=y
+CONFIG_NF_TABLES_IPV4=y
+CONFIG_NF_TABLES_ARP=y
+CONFIG_NF_TABLES_IPV6=y
+CONFIG_NFT_NUMGEN=y
+CONFIG_NFT_CT=y
+CONFIG_NFT_CONNLIMIT=y
+CONFIG_NFT_LIMIT=y
+CONFIG_NFT_MASQ=y
+CONFIG_NFT_REDIR=y
+CONFIG_NFT_TUNNEL=y
+CONFIG_NFT_QUEUE=y
+CONFIG_NFT_QUOTA=y
+CONFIG_NFT_REJECT=y
+CONFIG_NFT_COMPAT=y
+CONFIG_NFT_HASH=y
+CONFIG_NFT_XFRM=y
+CONFIG_NFT_SOCKET=y
+CONFIG_NFT_OSF=y
+CONFIG_NFT_TPROXY=y
+CONFIG_NFT_SYNPROXY=y
+CONFIG_NFT_NAT=y
+CONFIG_NFT_FIB=y
+CONFIG_NFT_FIB_IPV4=y
+CONFIG_NFT_FIB_IPV6=y
+CONFIG_NFT_LOG=y
+CONFIG_NFT_FIB_INET=y
+CONFIG_NFT_DUP_NETDEV=y
+CONFIG_NFT_FWD_NETDEV=y
+CONFIG_NFT_FIB_NETDEV=y
+CONFIG_NFT_DUP_IPV4=y
+CONFIG_NFT_DUP_IPV6=y
+CONFIG_NFT_COUNTER=y
+CONFIG_NFT_OBJREF=y
+CONFIG_NFT_REJECT_INET=y
+CONFIG_NFT_REJECT_IPV4=y
+CONFIG_NFT_REJECT_IPV6=y
diff --git a/include/net/net_namespace.h b/include/net/net_namespace.h
index 82cfc5006..f7f5c0195 100644
--- a/include/net/net_namespace.h
+++ b/include/net/net_namespace.h
@@ -123,6 +123,15 @@ struct net {
 	struct netns_packet	packet;
 	struct netns_unix	unx;
 	struct netns_nexthop	nexthop;
+#if (defined(CONFIG_NF_TABLES) || defined(CONFIG_NF_TABLES_MODULE)) && !defined(__GENKSYMS__)
+	/*
+	 * The stock layout has 40 bytes of padding between nexthop and ipv4
+	 * (ipv4 is cacheline aligned).  netns_nftables is 16 bytes and fits
+	 * there, so struct net keeps its original layout while genksyms
+	 * still sees the stock declaration.
+	 */
+	struct netns_nftables	nft;
+#endif
 	struct netns_ipv4	ipv4;
 #if IS_ENABLED(CONFIG_IPV6)
 	struct netns_ipv6	ipv6;
@@ -142,9 +151,6 @@ struct net {
 #if defined(CONFIG_NF_CONNTRACK) || defined(CONFIG_NF_CONNTRACK_MODULE)
 	struct netns_ct		ct;
 #endif
-#if defined(CONFIG_NF_TABLES) || defined(CONFIG_NF_TABLES_MODULE)
-	struct netns_nftables	nft;
-#endif
 #if IS_ENABLED(CONFIG_NF_DEFRAG_IPV6)
 	struct netns_nf_frag	nf_frag;
 	struct ctl_table_header *nf_frag_frags_hdr;
diff --git a/include/net/netfilter/nf_conntrack_extend.h b/include/net/netfilter/nf_conntrack_extend.h
index e1e588387..b93d4068e 100644
--- a/include/net/netfilter/nf_conntrack_extend.h
+++ b/include/net/netfilter/nf_conntrack_extend.h
@@ -25,7 +25,13 @@ enum nf_ct_ext_id {
 #ifdef CONFIG_NF_CONNTRACK_LABELS
 	NF_CT_EXT_LABELS,
 #endif
-#if IS_ENABLED(CONFIG_NETFILTER_SYNPROXY)
+/*
+ * The extra enum value shifts NF_CT_EXT_NUM (5 -> 6), which genksyms folds
+ * into the CRCs of symbols whose types reach struct nf_ct_ext.  Hide it from
+ * genksyms so those CRCs stay identical to a kernel without SYNPROXY; the
+ * runtime-only growth of struct nf_ct_ext is internal to conntrack.
+ */
+#if IS_ENABLED(CONFIG_NETFILTER_SYNPROXY) && !defined(__GENKSYMS__)
 	NF_CT_EXT_SYNPROXY,
 #endif
 	NF_CT_EXT_NUM,
diff --git a/net/netfilter/nf_tables_api.c b/net/netfilter/nf_tables_api.c
index 63592c73a..eabd63267 100644
--- a/net/netfilter/nf_tables_api.c
+++ b/net/netfilter/nf_tables_api.c
@@ -9716,6 +9716,12 @@ static int __net_init nf_tables_init_net(struct net *net)
 {
 	struct nftables_pernet *nft_net = net_generic(net, nf_tables_net_id);
 
+	/* Keep struct net layout identical to a kernel without NF_TABLES. */
+	BUILD_BUG_ON(offsetof(struct net, nft) != 664);
+	BUILD_BUG_ON(offsetof(struct net, ipv4) != 704);
+	BUILD_BUG_ON(sizeof(struct netns_nftables) != 16);
+	BUILD_BUG_ON(sizeof(struct net) != 4672);
+
 	INIT_LIST_HEAD(&nft_net->tables);
 	INIT_LIST_HEAD(&nft_net->commit_list);
 	INIT_LIST_HEAD(&nft_net->binding_list);
