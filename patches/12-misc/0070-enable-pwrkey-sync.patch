From 7aea1ce121462e74eede1e56809d1eeac870cb90 Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Sat, 31 Oct 2026 21:48:13 +0800
Subject: [PATCH] input: enable pwrkey-sync in GKI defconfig

Enable CONFIG_INPUT_PWRKEY_SYNC for the long-press filesystem sync
driver. PM_SLEEP is selected by the default SUSPEND option, so the
driver is available on this target.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 arch/arm64/configs/gki_defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index ee2391234..53fcbb6b7 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -858,6 +858,7 @@ CONFIG_DEBUG_INFO_DWARF4=y
 CONFIG_HEADERS_INSTALL=y
 # CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
 CONFIG_MAGIC_SYSRQ=y
+CONFIG_INPUT_PWRKEY_SYNC=y
 CONFIG_UBSAN=y
 CONFIG_UBSAN_TRAP=y
 CONFIG_UBSAN_LOCAL_BOUNDS=y
