From fd1dc1507913ddec83b631232aa5ab0f3f009d5d Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Wed, 28 Oct 2026 22:41:27 +0800
Subject: [PATCH] net: pin the stock netns_ipv4 layout

The l3mdev sysctls live in the alignment hole before tcp_death_row.
Pin tcp_death_row at 640 and the struct size at 960 with static_asserts
so future changes cannot silently move the stock vendor ABI.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 include/net/netns/ipv4.h | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/include/net/netns/ipv4.h b/include/net/netns/ipv4.h
index baf785b16..b240834e8 100644
--- a/include/net/netns/ipv4.h
+++ b/include/net/netns/ipv4.h
@@ -11,6 +11,8 @@
 #include <linux/rcupdate.h>
 #include <linux/siphash.h>
 #include <linux/android_kabi.h>
+#include <linux/build_bug.h>
+#include <linux/stddef.h>
 
 struct tcpm_hash_bucket;
 struct ctl_table_header;
@@ -231,4 +233,14 @@ struct netns_ipv4 {
 
 	ANDROID_KABI_RESERVE(1);
 };
+
+/*
+ * KMI pins: the l3mdev sysctls added under CONFIG_NET_L3_MASTER_DEV live
+ * in the alignment hole before tcp_death_row, so the stock offsets are
+ * preserved. Keep it that way.
+ */
+#ifndef __GENKSYMS__
+static_assert(offsetof(struct netns_ipv4, tcp_death_row) == 640);
+static_assert(sizeof(struct netns_ipv4) == 960);
+#endif
 #endif
