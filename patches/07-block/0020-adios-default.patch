From 720aeb68abc589442950b26f168600a7e6accabf Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Mon, 26 Oct 2026 20:58:32 +0800
Subject: [PATCH] phase10.10: make ADIOS the default I/O scheduler

Add MQ_ADIOS_DEFAULT and have elevator_init_mq() try adios first. This is only safe on top of the 10.9 blk-mq hctx ordering fix; the earlier attempt bootlooped because limit_depth() ran with data->hctx still unset.

Boot-tested on yudi. Note that vendor init (init.qti.kernel.rc) later rewrites sda-sdh/mmcblk to bfq, and cpq when persist.sys.stability.smartfocusio=on, so only overridden-yet queues keep adios.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 arch/arm64/configs/gki_defconfig | 3 +++
 block/Kconfig.iosched            | 7 +++++++
 block/elevator.c                 | 9 +++++++--
 3 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 917bdeddf..f7c56caab 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -898,3 +898,6 @@ CONFIG_DEFAULT_BBR3=y
 
 # Phase 10.8a: ADIOS available but not the default.
 CONFIG_MQ_IOSCHED_ADIOS=y
+
+# Phase 10.10: make ADIOS the default (blk-mq hctx ordering fixed in 10.9).
+CONFIG_MQ_ADIOS_DEFAULT=y
diff --git a/block/Kconfig.iosched b/block/Kconfig.iosched
index 886743bbb..8d02eeeee 100644
--- a/block/Kconfig.iosched
+++ b/block/Kconfig.iosched
@@ -31,6 +31,13 @@ config MQ_IOSCHED_ADIOS
 	  The Adaptive Deadline I/O Scheduler (ADIOS) is a multi-queue I/O
 	  scheduler with learning-based adaptive latency control.
 
+config MQ_ADIOS_DEFAULT
+	bool "ADIOS default I/O scheduler"
+	depends on MQ_IOSCHED_ADIOS
+	default y
+	help
+	  Use the Adaptive Deadline I/O Scheduler by default.
+
 config IOSCHED_BFQ
 	tristate "BFQ I/O scheduler"
 	help
diff --git a/block/elevator.c b/block/elevator.c
index a0a4a0319..dfff365c9 100644
--- a/block/elevator.c
+++ b/block/elevator.c
@@ -675,10 +675,15 @@ void elevator_init_mq(struct request_queue *q)
 	if (unlikely(q->elevator))
 		return;
 
-	if (!q->required_elevator_features)
+	if (IS_ENABLED(CONFIG_MQ_ADIOS_DEFAULT)) {
+		e = elevator_get(q, "adios", false);
+		if (!e && !q->required_elevator_features)
+			e = elevator_get_default(q);
+	} else if (!q->required_elevator_features) {
 		e = elevator_get_default(q);
-	else
+	} else {
 		e = elevator_get_by_features(q);
+	}
 	if (!e)
 		return;
 
