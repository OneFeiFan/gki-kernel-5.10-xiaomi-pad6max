From 7465e0bfa749aeee0b4c8dee3157767ff5ddb24d Mon Sep 17 00:00:00 2001
From: OneFeiFan <3022504358@qq.com>
Date: Sat, 31 Oct 2026 20:10:12 +0800
Subject: [PATCH] block: adios: fix MQ_AWARE and flush/FUA completions

Remove the incorrect ELEVATOR_F_MQ_AWARE flag: ADIOS is not blk-mq aware. Ignore flush/FUA requests in adios_completed_request(); they carry no scheduler data and the existing NULL check alone is not enough. Keep the NULL check.

Origin: Pzqqt Melt c8e6f8db45, 62c201a18f (upstream 4d337cebcb1c, dd6216bb16e8)

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 block/adios.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/block/adios.c b/block/adios.c
index ddd8fa926..8cc49975b 100644
--- a/block/adios.c
+++ b/block/adios.c
@@ -1399,7 +1399,8 @@ static void adios_completed_request(struct request *rq, u64 now) {
 	struct adios_rq_data *rd = get_rq_data(rq);
 	union adios_in_flight_rqs ifr = { .scalar = 0 };
 
-	if (!rd)
+	// Flush/FUA requests carry no scheduler data.
+	if (op_is_flush(rq->cmd_flags) || !rd)
 		return;
 
 	if (rd->managed) {
@@ -2041,7 +2042,6 @@ static struct elevator_type mq_adios = {
 	},
 	.elevator_attrs = adios_sched_attrs,
 	.elevator_name = "adios",
-	.elevator_features = ELEVATOR_F_MQ_AWARE,
 	.elevator_owner = THIS_MODULE,
 };
 MODULE_ALIAS("mq-adios-iosched");
