+++ b/arch/arm64/configs/gki_defconfig
@@ -69,6 +69,8 @@ CONFIG_ARCH_QCOM=y
 CONFIG_ARCH_SPRD=y
 CONFIG_ARM64_ERRATUM_2454944=y
 CONFIG_SCHED_MC=y
+# yudi: CFS bandwidth (kABI-safe split)
+CONFIG_CFS_BANDWIDTH=y
 CONFIG_NR_CPUS=32
 CONFIG_PARAVIRT=y
 CONFIG_ARM64_SW_TTBR0_PAN=y
